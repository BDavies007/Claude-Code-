# ─────────────────────────────────────────────────────────────
# Executive OS — environment variables
# Copy this file to `.env.local` and fill in your Supabase values.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER expose to the client.
# Used for seed scripts / privileged server tasks only.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# AI daily brief (optional — falls back to a local generator)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Overrides (optional)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Integrations (Phase 0+) — see docs/INTEGRATIONS.md & n8n/README.md
# ─────────────────────────────────────────────────────────────
# Google OAuth (Calendar + Gmail + Drive in one grant)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/integrations/google/callback

# 32-byte secret used to encrypt stored OAuth tokens at rest (hex/base64/raw)
INTEGRATION_TOKEN_ENC_KEY=

# Shared secret the n8n orchestrator sends when calling the app's sync endpoints
N8N_WEBHOOK_SECRET=

# Embeddings for Drive/RAG semantic search (1536-dim to match the schema)
EMBEDDINGS_MODEL=text-embedding-3-small
