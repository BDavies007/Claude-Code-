# ─────────────────────────────────────────────────────────────
# Executive OS — environment variables
# Copy this file to `.env.local` and fill in your Supabase values.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. NEVER expose to the client.
# Used for seed scripts / privileged server tasks only.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
